# ---------------------------------------------------------------------------
# pnpm security settings
# ---------------------------------------------------------------------------

# Block all package install/postinstall scripts by default.
# Only packages listed under pnpm.onlyBuiltDependencies in package.json
# are allowed to run their build scripts. This is the primary defence against
# supply-chain malware that hides in postinstall hooks.
# NOTE: pnpm enforces this; plain npm ignores this file key entirely.

# Integrity checking — pnpm always uses SHA-512 in its lockfile; this makes
# the behaviour explicit.
verify-store-integrity=true

# Refuse to install if the lockfile would need to be updated.
# Flip to false locally if you're upgrading deps on purpose.
# (In CI/CD this should always be true.)
frozen-lockfile=false

# No "support the author" funding messages cluttering output.
fund=false

# Peer dependency mismatches are warned about, not fatal — most Vue ecosystem
# packages lag behind in declaring peers correctly.
strict-peer-dependencies=false
