# ---------------------------------------------------------------------------
# pnpm registry and auth settings (pnpm 11)
# All other pnpm config lives in pnpm-workspace.yaml.
# ---------------------------------------------------------------------------

# Pin to the official npm registry.
# Prevents accidental installs from a compromised global .npmrc or env var.
registry=https://registry.npmjs.org/

# Enforce TLS for all registry connections.
strict-ssl=true
